@model FrameCloud.Entities.Video
@{
	ViewData["Title"] = "Просмотр видео";
	var otherVideos = ViewBag.OtherVideos as List<FrameCloud.Entities.Video>;
	var comments = ViewBag.Comments as IEnumerable<FrameCloud.Entities.Comment>;
}

<div class="row">
	<div class="col-md-8">
		<h2>@Model.Name</h2>
		<video src="@Model.Url" controls class="w-100 mb-3 "></video>
		<p>@Model.Description</p>
		<p>Просмотры: @Model.ViewersCount | Рейтинг: @Model.Rating</p>

		<h4 class="mt-4">Комментарии</h4>

		@if (User.Identity?.IsAuthenticated ?? false)
		{
			var userMark = ViewBag.UserMark as FrameCloud.Entities.Mark;

			<div class="mb-3">
				<form method="post" asp-controller="Mark" asp-action="Like" class="d-inline">
					<input type="hidden" name="videoId" value="@Model.Id" />
					<button type="submit" class="btn @(userMark?.IsLike == true ? "btn-success" : "btn-outline-success")">
						👍 Лайк
					</button>
				</form>
				<form method="post" asp-controller="Mark" asp-action="Dislike" class="d-inline">
					<input type="hidden" name="videoId" value="@Model.Id" />
					<button type="submit" class="btn @(userMark?.IsLike == false ? "btn-danger" : "btn-outline-danger")">
						👎 Дизлайк
					</button>
				</form>
			</div>
		}

		else
		{
			<p class="text-muted">Авторизуйтесь, чтобы оставлять комментарии.</p>
		}

		<div class="mt-3">
			@if (comments != null && comments.Any())
			{
				@foreach (var c in comments)
				{
					<div class="border p-2 mb-2">
						<strong>@c.UserLogin</strong> <small class="text-muted">(@c.Date.ToString("g"))</small>
						<p>@c.Text</p>
					</div>
				}
			}
			else
			{
				<p class="text-muted">Комментариев пока нет.</p>
			}
		</div>
	</div>

	<div class="col-md-4">
		<h4>Другие видео</h4>
		@foreach (var v in otherVideos)
		{
			<div class="card mb-3">
				<video src="@v.Url" class="card-img-top video-preview" preload="metadata"></video>
				<div class="card-body">
					<h6 class="card-title">@v.Name</h6>
					<a asp-controller="Video" asp-action="Watch" asp-route-id="@v.Id" class="btn btn-sm btn-primary">
						Смотреть
					</a>
				</div>
			</div>
		}
	</div>
</div>
