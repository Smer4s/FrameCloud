@model FrameCloud.Entities.Video
@{
	ViewData["Title"] = "Редактировать видео";
}

<div class="row justify-content-center">
	<div class="col-md-6">
		<h2 class="text-center">Редактировать видео</h2>
		<form asp-action="Edit" method="post">
			<input type="hidden" asp-for="Id" />
			<input type="hidden" asp-for="ChannelId" />
			<input type="hidden" asp-for="Url" /> <!-- скрытое поле, чтобы URL сохранился -->

			<div class="mb-3">
				<label class="form-label">Название</label>
				<input class="form-control" asp-for="Name" />
			</div>

			<div class="mb-3">
				<label class="form-label">Описание</label>
				<textarea class="form-control" asp-for="Description"></textarea>
			</div>

			<div class="form-check mb-3">
				<input class="form-check-input" asp-for="IsPublic" />
				<label class="form-check-label">Публичное видео</label>
			</div>

			<button type="submit" class="btn btn-primary w-100">Сохранить</button>
		</form>
	</div>
</div>
