@model FrameCloud.Entities.Channel
@{
	ViewData["Title"] = "Канал";
	var videos = ViewBag.Videos as List<FrameCloud.Entities.Video>;
	var currentUserId = User.Identity?.IsAuthenticated == true
					? int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
					: -1;
	bool isOwner = currentUserId == Model.OwnerId;
}

<div class="text-center">
	<h1 class="display-4">@Model.Name</h1>
	<p>@Model.Description</p>
	<p>Подписчиков: @Model.SubscribersCount</p>

	@if (isOwner)
	{
		<form asp-controller="Video" asp-action="Upload" method="get">
			<button type="submit" class="btn btn-success mb-3">Создать видео</button>
		</form>
	}
	else if (User.Identity?.IsAuthenticated == true)
	{
		var isSubscribed = ViewBag.IsSubscribed as bool? ?? false;

		<div class="mb-3">
			@if (isSubscribed)
			{
				<form asp-controller="Subscription" asp-action="Unsubscribe" method="post">
					<input type="hidden" name="channelId" value="@Model.Id" />
					<button type="submit" class="btn btn-secondary">Отписаться</button>
				</form>
			}
			else
			{
				<form asp-controller="Subscription" asp-action="Subscribe" method="post">
					<input type="hidden" name="channelId" value="@Model.Id" />
					<button type="submit" class="btn btn-primary">Подписаться</button>
				</form>
			}
		</div>
	}

	@if (videos == null || videos.Count == 0)
	{
		<p>Видео пока нет</p>
	}
	else
	{
		<h3 class="mt-4">Видео канала</h3>
		<div class="row">
			@foreach (var video in videos)
			{
				<div class="col-md-6 mb-4">
					<div class="card">
						<div class="card-body">
							<h5 class="card-title">@video.Name</h5>
							<p class="card-text">@video.Description</p>
							<video src="@video.Url" class="w-100 video-preview"></video>
							<p class="mt-2">Просмотры: @video.ViewersCount | Рейтинг: @video.Rating</p>

							<div class="d-flex justify-content-between mt-2">
								<a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id"
									 class="btn btn-primary btn-sm">Посмотреть</a>

								@if (isOwner)
								{
									<div>
										<form asp-controller="Video" asp-action="Edit" method="get" class="d-inline">
											<input type="hidden" name="id" value="@video.Id" />
											<button type="submit" class="btn btn-warning btn-sm">Редактировать</button>
										</form>

										<form asp-controller="Video" asp-action="Delete" method="post" class="d-inline">
											<input type="hidden" name="id" value="@video.Id" />
											<button type="submit" class="btn btn-danger btn-sm">Удалить</button>
										</form>
									</div>
								}
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
</div>
