@using FrameCloud.Data
@model IEnumerable<UserView>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Логин</th>
			<th>Есть канал</th>
			<th>Действия</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var user in Model)
		{
			<tr>
				<td>@user.Login</td>
				<td>@(user.HasChannel ? "Да" : "Нет")</td>
				<td>
					@if (user.HasChannel)
					{
						<a asp-controller="Channel" asp-action="Index" asp-route-id="@user.Id"
							 class="btn btn-sm btn-success">Перейти на канал</a>
					}
					<a asp-action="Ban" asp-route-userId="@user.Id"
						 class="btn btn-sm btn-danger">Забанить</a>
					<a asp-action="Logs" asp-route-userId="@user.Id"
						 class="btn btn-sm btn-secondary">Посмотреть логи</a>
				</td>
			</tr>
		}
	</tbody>
</table>
